{
  "name": "auth-system",
  "version": "1.0.0",
  "description": "A small auth system",
  "keywords": [
    "node",
    "authentication",
    "token"
  ],
  "license": "ISC",
  "author": "Joel B Eapen",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "npx nodemon server.js",
    "worker": "nodemon src/workers/startUploadWorker.js",
    "worker:upload": "nodemon src/workers/startUploadWorker.js",
    "worker:email": "nodemon src/workers/startEmailWorker.js",
    "worker:maintenance": "nodemon src/workers/startMaintenanceWorker.js",
    "start": "node server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:postman": "node scripts/generate-postman-collection.js",
    "seed:loadtest-users": "node scripts/seed-loadtest-users.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:load:smoke": "k6 run -e TEST_TYPE=smoke load-tests/scenarios/user.js",
    "test:load": "k6 run -e TEST_TYPE=load load-tests/scenarios/user.js",
    "test:load:stress": "k6 run -e TEST_TYPE=stress load-tests/scenarios/user.js",
    "test:load:spike": "k6 run -e TEST_TYPE=spike load-tests/scenarios/user.js",
    "test:load:public": "k6 run -e TEST_TYPE=load load-tests/scenarios/public.js",
    "test:load:vendor": "k6 run -e TEST_TYPE=load load-tests/scenarios/vendor.js",
    "test:load:admin": "k6 run -e TEST_TYPE=load load-tests/scenarios/admin.js",
    "test:load:delivery": "k6 run -e TEST_TYPE=load load-tests/scenarios/delivery.js",
    "test:load:ratelimit": "k6 run load-tests/scenarios/rate-limit.js",
    "test:load:mixed": "k6 run load-tests/scenarios/mixed-user.js",
    "test:load:mixed:smoke": "k6 run -e TEST_TYPE=smoke load-tests/scenarios/mixed-user.js"
  },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.2",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.19.1",
    "prettier": "^3.9.1",
    "rate-limiter-flexible": "^11.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2"
  }
}
