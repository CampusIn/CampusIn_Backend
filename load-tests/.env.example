BASE_URL=http://localhost:3000

# Single-user fallback (all VUs share one account)
TEST_USER_EMAIL=single-user@example.com
TEST_USER_PASSWORD=your-password

# Preferred for stateful cart tests: one account per VU
TEST_USER_EMAILS=user1@example.com,user2@example.com,user3@example.com
# Option A: one shared password for all TEST_USER_EMAILS
# TEST_USER_PASSWORD=shared-password
# Option B: per-user passwords (same order as TEST_USER_EMAILS)
# TEST_USER_PASSWORDS=password1,password2,password3

# Optional JSON pool for user credentials
# TEST_USERS_JSON=[{"email":"user1@example.com","password":"password1"},{"email":"user2@example.com","password":"password2"}]

# Allow account reuse when user pool size is smaller than max VUs in the selected profile
ALLOW_SHARED_TEST_USERS=true

TEST_TYPE=smoke
TARGET_VUS=10
MIXED_WRITE_ENABLED=true
USE_VU_IP_DISTRIBUTION=true

# Optional fixed IDs (real IDs only)
# TEST_RESTAURANT_IDS=restaurantId1,restaurantId2
# TEST_MENU_ITEM_IDS=menuItemId1,menuItemId2
# TEST_MARKETPLACE_PRODUCT_IDS=productId1,productId2
