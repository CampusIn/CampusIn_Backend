PORT=3000

# Database
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database>?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth
CLIENT_ID=google-oauth-client-id
GOOGLE_CLIENT_ID=google-oauth-client-id
GOOGLE_CLIENT_SECRET=google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
CLIENT_URL=http://localhost:5173

# ZeptoMail SMTP credentials
ZEPTOMAIL_HOST=smtp.zeptomail.com
ZEPTOMAIL_PORT=587
ZEPTOMAIL_USER=your-zeptomail-smtp-username
ZEPTOMAIL_PASS=your-zeptomail-smtp-password
ZEPTOMAIL_FROM_EMAIL=order@example.com
ZEPTOMAIL_FROM_NAME=Campus In

# Cloudinary
CLOUDINARY_NAME=cloudinary-cloud-name
CLOUDINARY_API_KEY=cloudinary-api-key
CLOUDINARY_API_SECRET=cloudinary-api-secret

# Redis (self-hosted)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-a-strong-redis-password
